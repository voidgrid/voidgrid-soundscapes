# Copy to .env next to compose.yaml. Keep it private (chmod 600 .env): it holds a token and a password.

# --- docker -------------------------------------------------------------------------------------------
# Which image to run: :beta (newest release of any kind), :latest (newest stable), or one exact version.
VGS_IMAGE=ghcr.io/voidgrid/voidgrid-soundscapes:beta
VGS_PORT=8007
# Host folders. The audio folder holds your sounds; the config folder must be writable by uid 1000
# (mkdir config && chown 1000:1000 config).
VGS_AUDIO_DIR=./audio
VGS_CONFIG_DIR=./config

# --- the program --------------------------------------------------------------------------------------
# How a speaker reaches this program (an address the SPEAKER can use, not localhost). Needed to play on a speaker.
VOIDGRID_SOUNDSCAPES_PUBLIC_URL=http://192.168.1.10:8007

# Home Assistant: lets the web page list and control your media players. Set both or neither.
# The token is a long-lived access token (HA profile page, Security, Long-lived access tokens).
#VOIDGRID_SOUNDSCAPES_HA_URL=http://192.168.1.20:8123
#VOIDGRID_SOUNDSCAPES_HA_TOKEN=

# MQTT: adds the Home Assistant entities (needs the Home Assistant settings above to be of any use).
#VOIDGRID_SOUNDSCAPES_MQTT_URL=tcp://192.168.1.20:1883
#VOIDGRID_SOUNDSCAPES_MQTT_USER=
#VOIDGRID_SOUNDSCAPES_MQTT_PASSWORD=
# The device name in Home Assistant. Entity IDs, topics and the MQTT client ID derive from it, so a second
# instance (or one beside another tool) needs its own.
#VOIDGRID_SOUNDSCAPES_DEVICE_NAME=Voidgrid Soundscapes

#VOIDGRID_SOUNDSCAPES_LOG_LEVEL=info
